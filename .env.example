# Copy this file to .env.local and fill in real values.
# Get these from your Hyperswitch sandbox dashboard: Developers > API keys.

# Secret key — server-side only, never exposed to the browser.
HYPERSWITCH_API_KEY=snd_your_secret_key_here

# Publishable key — safe to expose to the browser, used by the checkout widget.
NEXT_PUBLIC_HYPERSWITCH_PUBLISHABLE_KEY=pk_snd_your_publishable_key_here

# Hyperswitch sandbox API base URL.
HYPERSWITCH_BASE_URL=https://sandbox.hyperswitch.io

# Webhook signing secret — the business profile's payment_response_hash_key
# from the Hyperswitch dashboard (Settings > Business profile). Server-side
# only; never expose it to the browser and never commit a real value. The
# webhook route fails CLOSED: if this is unset it rejects every delivery
# with 503 rather than trusting an unverifiable body, so set it before any
# webhook can be processed.
HYPERSWITCH_WEBHOOK_SECRET=your_payment_response_hash_key_here

# Optional: the expected Hyperswitch merchant id. When set, every payment
# reconciliation path (webhook, payment-status read, hold expiry) requires
# the retrieved payment to carry EXACTLY this merchant_id — a missing or a
# different merchant_id fails binding. Leave it unset to skip that check;
# the order-association, amount, and currency checks still apply.
# HYPERSWITCH_MERCHANT_ID=your_merchant_id_here

# Optional: per-request timeout (ms) for outbound Hyperswitch calls.
# Defaults to 10000. Lower it only for tuning/tests.
# HYPERSWITCH_TIMEOUT_MS=10000

# Upstash Redis (REST API) — orders and inventory counters. Create a
# database at https://console.upstash.com and copy these from its
# "REST API" tab.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
